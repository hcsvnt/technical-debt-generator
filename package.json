{
  "name": "todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --hot apps/server/src/index.ts",
    "start": "NODE_ENV=production bun apps/server/src/index.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter @todo/server db:generate"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
